digraph pipeline {
  rankdir=LR;
  node [shape=box, style="rounded,filled", fillcolor="white"];
  edge [color="#444444"];

  subgraph cluster_astrophysics {
    label="astrophysics";
    style="dashed";
    color="#377eb8";
    calculate_received_astro_fluxes;
    arrange_onsky_scene;
  }

  subgraph cluster_instrument_transmission_per_angle {
    label="instrument transmission (per angle)";
    style="dashed";
    color="#e41a1c";
    generate_instrument_transmission;
  }

  calculate_received_astro_fluxes [label="calculate_received_astro_fluxes"];
  arrange_onsky_scene [label="arrange_onsky_scene"];
  disperse_astro_signals_on_detector [label="disperse_astro_signals_on_detector"];
  record_info_at_angle_and_qe [label="record_info_at_angle_and_qe"];
  apply_detector_effects [label="apply_detector_effects"];
  assemble_extracted_spectra_cubes [label="assemble_extracted_spectra_cubes"];
  pass_through_aperture [label="pass_through_aperture"];
  pass_from_aperture_to_detector [label="pass_from_aperture_to_detector"];
  write_detector_readouts [label="write_detector_readouts"];
  extract_spectra_from_readouts [label="extract_spectra_from_readouts"];
  generate_instrument_transmission [label="generate_instrument_transmission"];
  pass_through_transmission_screens [label="pass_through_transmission_screens"];

  calculate_received_astro_fluxes -> arrange_onsky_scene;
  pass_from_aperture_to_detector -> disperse_astro_signals_on_detector;
  extract_spectra_from_readouts -> record_info_at_angle_and_qe;
  disperse_astro_signals_on_detector -> apply_detector_effects;
  record_info_at_angle_and_qe -> assemble_extracted_spectra_cubes;
  pass_through_transmission_screens -> pass_through_aperture;
  pass_through_aperture -> pass_from_aperture_to_detector;
  apply_detector_effects -> write_detector_readouts;
  write_detector_readouts -> extract_spectra_from_readouts;
  arrange_onsky_scene -> pass_through_transmission_screens;
  generate_instrument_transmission -> pass_through_transmission_screens;
}
